# Copy to .env for Docker Compose. Never commit real secrets.

# Backend auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
OTP_PEPPER=replace-with-a-random-otp-pepper

# Initial admin (created on first boot when no admin exists)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@ebank.local
ADMIN_PASSWORD=Admin@12345

# Email
EMAIL_FROM=E-Banking <no-reply@ebank.local>

# Webhooks: allow private/localhost targets only for local development
WEBHOOK_ALLOW_PRIVATE=true

# Observability
LOG_LEVEL=info
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Local (non-Docker) development
MONGO_URI=mongodb://localhost:27017/ebank?replicaSet=rs0
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
