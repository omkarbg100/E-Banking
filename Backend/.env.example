# Copy to Backend/.env for local (non-Docker) development.

NODE_ENV=development
PORT=5000

# MongoDB must be a replica set for multi-document transactions.
MONGO_URI=mongodb://localhost:27017/ebank?replicaSet=rs0

# Redis is required for OTPs, caching, rate limits, idempotency and BullMQ.
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ebank

# Kafka is optional. Leave KAFKA_BROKERS empty to use the in-process event bus.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=ebank-backend
KAFKA_GROUP_ID=ebank-backend-consumer

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Mailpit (Docker) SMTP. For Gmail, set EMAIL_SERVICE=gmail and SMTP_USER/SMTP_PASS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=E-Banking <no-reply@ebank.local>
# EMAIL_SERVICE=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-random-otp-pepper

ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@ebank.local
ADMIN_PASSWORD=Admin@12345

# Allow localhost/private webhook targets only in development.
WEBHOOK_ALLOW_PRIVATE=true
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=5

LOG_LEVEL=info
